model IntegrationCredential {
  connectionId   String                @id
  organizationId String
  ciphertext     String
  createdAt      DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @db.Timestamp(3)
  updatedAt      DateTime              @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)")) @db.Timestamp(3)
  connection     IntegrationConnection @relation(fields: [connectionId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Restrict, map: "IntegrationCredential_connection_scope_fkey")

  @@unique([connectionId, organizationId], map: "IntegrationCredential_connectionId_organizationId_key")
}
