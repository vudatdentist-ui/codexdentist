  id           String                      @id @default(cuid())
  poolRuleId   String
  poolRule     ServiceCompensationPoolRule @relation(fields: [poolRuleId], references: [id], onDelete: Cascade)
  role         ServiceCompensationRole
  sharePercent Decimal                     @default(0) @db.Decimal(5, 2)
  fallbackRole ServiceCompensationRole?
  required     Boolean                     @default(false)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@unique([poolRuleId, role])
}

model TreatmentService {
  id                      String                          @id @default(cuid())
  organizationId          String
  organization            Organization                    @relation(fields: [organizationId], references: [id])
  clinicId                String
  clinic                  Clinic                          @relation(fields: [clinicId], references: [id])
  patientId               String
  patient                 Patient                         @relation(fields: [patientId], references: [id])
  treatmentPlanId         String?
  treatmentPlan           TreatmentPlan?                  @relation(fields: [treatmentPlanId], references: [id])
  serviceCatalogItemId    String?
  serviceCatalogItem      ServiceCatalogItem?             @relation(fields: [serviceCatalogItemId], references: [id])
  compensationRuleId      String?
  compensationRule        ServiceCompensationRule?        @relation("TreatmentServiceCompensationRule", fields: [compensationRuleId], references: [id])
  compensationRuleCode    String?
  compensationRuleName    String?
  compensationRuleVersion String?
  createdById             String
  createdBy               User                            @relation("TreatmentServiceCreator", fields: [createdById], references: [id])
  serviceCode             String
  serviceName             String
  targetSummary           String?
  teeth                   String[]
  status                  TreatmentServiceStatus          @default(PLANNED)
  finalPrice              Decimal                         @db.Decimal(12, 2)
  currentProgressPercent  Decimal                         @default(0) @db.Decimal(5, 2)
  currentStepSequence     Int?
  progressEvents          TreatmentServiceProgressEvent[]
  invoiceItems            InvoiceItem[]
  receiptAllocations      ReceiptAllocation[]
  compensationAccruals    CompensationAccrual[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([clinicId, status])
  @@index([patientId, createdAt])
  @@index([serviceCatalogItemId])
  @@index([compensationRuleId])
  @@index([createdById])
}

model TreatmentServiceProgressEvent {
  id                   String               @id @default(cuid())
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])
  clinicId             String
  clinic               Clinic               @relation(fields: [clinicId], references: [id])
  treatmentServiceId   String
  treatmentService     TreatmentService     @relation(fields: [treatmentServiceId], references: [id], onDelete: Cascade)
  performedById        String
  performedBy          User                 @relation("TreatmentProgressPerformer", fields: [performedById], references: [id])
  clinicalSupportId    String?
  clinicalSupport      User?                @relation("TreatmentProgressClinicalSupport", fields: [clinicalSupportId], references: [id])
  assistantPrimaryId   String?
  assistantPrimary     User?                @relation("TreatmentProgressAssistantPrimary", fields: [assistantPrimaryId], references: [id])
  assistantSecondaryId String?
  assistantSecondary   User?                @relation("TreatmentProgressAssistantSecondary", fields: [assistantSecondaryId], references: [id])
  fromProgressPercent  Decimal              @db.Decimal(5, 2)
  toProgressPercent    Decimal              @db.Decimal(5, 2)
  progressDeltaPercent Decimal              @db.Decimal(5, 2)
  fromStepSequence     Int?
  toStepSequence       Int?
  note                 String?
  occurredAt           DateTime             @default(now())
  compensationAccrual  CompensationAccrual?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([clinicId, occurredAt])
  @@index([treatmentServiceId, occurredAt])
  @@index([performedById, occurredAt])
}

model CompensationAccrual {
  id                    String                        @id @default(cuid())
  organizationId        String
  organization          Organization                  @relation(fields: [organizationId], references: [id])
  clinicId              String
  clinic                Clinic                        @relation(fields: [clinicId], references: [id])
  treatmentServiceId    String
  treatmentService      TreatmentService              @relation(fields: [treatmentServiceId], references: [id], onDelete: Cascade)
  progressEventId       String                        @unique
  progressEvent         TreatmentServiceProgressEvent @relation(fields: [progressEventId], references: [id], onDelete: Cascade)
  ruleId                String?
  rule                  ServiceCompensationRule?      @relation(fields: [ruleId], references: [id])
  ruleCode              String?
  ruleName              String?
  ruleVersion           String?
  ruleSnapshot          Json?
  payrollRunId          String?
  payrollRun            PayrollRun?                   @relation(fields: [payrollRunId], references: [id])
  status                CompensationAccrualStatus     @default(EARNED)
  serviceAmount         Decimal                       @db.Decimal(12, 2)
  earnedProgressPercent Decimal                       @db.Decimal(5, 2)
  doctorPoolAmount      Decimal                       @default(0) @db.Decimal(12, 2)
  assistantPoolAmount   Decimal                       @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                       @default(0) @db.Decimal(12, 2)
  lines                 CompensationAccrualLine[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@index([clinicId, status])
  @@index([treatmentServiceId])
  @@index([payrollRunId])
}

model CompensationAccrualLine {
  id                   String                   @id @default(cuid())
  organizationId       String
  organization         Organization             @relation(fields: [organizationId], references: [id])
  clinicId             String
  clinic               Clinic                   @relation(fields: [clinicId], references: [id])
  accrualId            String
  accrual              CompensationAccrual      @relation(fields: [accrualId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                     @relation("CompensationLineUser", fields: [userId], references: [id])
  payrollLineId        String?
  payrollLine          PayrollLine?             @relation(fields: [payrollLineId], references: [id])
  pool                 ServiceCompensationPool
  role                 ServiceCompensationRole
  sharePercent         Decimal                  @db.Decimal(5, 2)
  amount               Decimal                  @db.Decimal(12, 2)
  resolvedFromFallback Boolean                  @default(false)
  sourceRole           ServiceCompensationRole?
  note                 String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([clinicId, createdAt])
  @@index([userId, createdAt])
  @@index([payrollLineId])
}

model MedicationCatalogItem {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id])
  code               String
  genericName        String
  brandName          String?
  strength           String?
  form               String?
  defaultSig         String?
  defaultDose        String?
  route              String?
  frequency          String?
  warnings           String[]
  active             Boolean                    @default(true)
  serviceMedications ServiceMedication[]
  templateItems      PrescriptionTemplateItem[]
  prescriptionItems  PrescriptionItem[]
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, genericName])
}

model PrescriptionTemplate {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?                    @relation(fields: [clinicId], references: [id])
  createdById    String?
  createdBy      User?                      @relation("PrescriptionTemplateAuthor", fields: [createdById], references: [id])
  code           String
  name           String
  diagnosis      String?
  instructions   String?
  active         Boolean                    @default(true)
  items          PrescriptionTemplateItem[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([organizationId, code])
  @@index([clinicId])
}

model PrescriptionTemplateItem {
  id           String                 @id @default(cuid())
  templateId   String
  template     PrescriptionTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  medicationId String?
  medication   MedicationCatalogItem? @relation(fields: [medicationId], references: [id])
  drugName     String
  sig          String
  quantity     String?
  refills      Int                    @default(0)
  durationDays Int?
  instructions String?

  @@index([templateId])
}

model Prescription {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id])
  prescriberId   String
  prescriber     User               @relation("PrescriptionPrescriber", fields: [prescriberId], references: [id])
  prescriptionNo String             @unique
  status         PrescriptionStatus @default(DRAFT)
  diagnosis      String?
  notes          String?
  signedAt       DateTime?
  printedAt      DateTime?
  cancelledAt    DateTime?
  items          PrescriptionItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([clinicId, createdAt])
  @@index([patientId, createdAt])
}

model PrescriptionItem {
  id             String                 @id @default(cuid())
  prescriptionId String
  prescription   Prescription           @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String?
  medication     MedicationCatalogItem? @relation(fields: [medicationId], references: [id])
  drugName       String
  strength       String?
  sig            String
  quantity       String?
  refills        Int                    @default(0)
  durationDays   Int?
  instructions   String?

  @@index([prescriptionId])
}

model FormTemplate {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  clinicId          String?
  clinic            Clinic?          @relation(fields: [clinicId], references: [id])
  createdById       String?
  createdBy         User?            @relation("FormTemplateCreator", fields: [createdById], references: [id])
  type              FormTemplateType
  code              String
  name              String
  version           String
  schema            Json
  body              String?
  requiresSignature Boolean          @default(false)
  active            Boolean          @default(true)
  forms             PatientForm[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([organizationId, code, version])
  @@index([clinicId, type])
}

model PatientForm {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?           @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  templateId     String
  template       FormTemplate      @relation(fields: [templateId], references: [id])
  requestedById  String?
  requestedBy    User?             @relation("PatientFormRequester", fields: [requestedById], references: [id])
  formNo         String            @unique
  status         PatientFormStatus @default(DRAFT)
  responses      Json?
  signatureUrl   String?
  attachments    String[]
  sentAt         DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId, status])
  @@index([clinicId, status])
}

model PatientFile {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  clinicId            String
  clinic              Clinic       @relation(fields: [clinicId], references: [id])
  patientId           String
  patient             Patient      @relation(fields: [patientId], references: [id])
  uploadedById        String?
  uploadedBy          User?        @relation("PatientFileUploader", fields: [uploadedById], references: [id])
  category            String       @default("CLINICAL_IMAGE")
  title               String
  fileName            String?
  mimeType            String?
  url                 String
  sizeBytes           Int?
  sourceType          String?
  sourceId            String?
  storageProvider     String?
  storageBucket       String?
  storageKey          String?
  checksumSha256      String?
  previewUrl          String?
  previewMimeType     String?
  previewSizeBytes    Int?
  previewStorageKey   String?
  thumbnailUrl        String?
  thumbnailMimeType   String?
  thumbnailSizeBytes  Int?
  thumbnailStorageKey String?
  virusScanStatus     String       @default("NOT_SCANNED")
  retentionUntil      DateTime?
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([patientId, createdAt])
  @@index([clinicId, createdAt])
  @@index([organizationId, category])
  @@index([organizationId, retentionUntil])
}

model PatientJourneyState {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  clinicId           String
  clinic             Clinic       @relation(fields: [clinicId], references: [id])
  patientId          String       @unique
  patient            Patient      @relation(fields: [patientId], references: [id])
  treatmentGoal      String?
  treatmentPlan      String?
  odontogramTeeth    String[]
  odontogramSnapshot Json?
  updatedById        String?
  updatedBy          User?        @relation("PatientJourneyStateUpdater", fields: [updatedById], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([clinicId, updatedAt])
  @@index([organizationId, updatedAt])
}

model JourneyComment {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic                     @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient                    @relation(fields: [patientId], references: [id])
  authorId       String?
  author         User?                      @relation("JourneyCommentAuthor", fields: [authorId], references: [id])
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  patientFileId  String?
  attachments    JourneyCommentAttachment[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([patientId, createdAt])
  @@index([clinicId, createdAt])
  @@index([organizationId, createdAt])
}

model JourneyCommentAttachment {
  id            String         @id @default(cuid())
  commentId     String
  comment       JourneyComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  patientFileId String?
  url           String
  name          String?
  mimeType      String?
  fileKind      String?
  sizeBytes     Int?
  previewUrl    String?
  thumbnailUrl  String?
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([commentId, sortOrder])
  @@index([patientFileId])
}

model WorkItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("WorkItemAssignee", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      User?        @relation("WorkItemCreator", fields: [createdById], references: [id])
  completedById  String?
  completedBy    User?        @relation("WorkItemCompleter", fields: [completedById], references: [id])
  sourceKind     String
  sourceId       String?
  priority       String       @default("medium")
  status         String       @default("OPEN")
  title          String
  detail         String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, dueAt])
  @@index([clinicId, status, dueAt])
  @@index([assignedToId, status, dueAt])
  @@index([patientId, createdAt])
  @@index([sourceKind, sourceId])
}

model LearningContent {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id])
  clinicId        String?
  clinic          Clinic?              @relation(fields: [clinicId], references: [id])
  authorId        String?
  author          User?                @relation("LearningContentAuthor", fields: [authorId], references: [id])
  code            String
  type            LearningContentType
  title           String
  summary         String?
  body            String?
  mediaUrl        String?
  durationMinutes Int?
  publishedAt     DateTime?
  active          Boolean              @default(true)
  assets          LearningAsset[]
  enrollments     LearningEnrollment[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([organizationId, code])
  @@index([clinicId, type])
}

model LearningAsset {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id])
  clinicId            String?
  clinic              Clinic?         @relation(fields: [clinicId], references: [id])
  contentId           String
  content             LearningContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  uploadedById        String?
  uploadedBy          User?           @relation("LearningAssetUploader", fields: [uploadedById], references: [id])
  kind                String
  title               String
  fileName            String?
  mimeType            String?
  url                 String
  sizeBytes           Int?
  storageProvider     String?
  storageBucket       String?
  storageKey          String?
  checksumSha256      String?
  previewUrl          String?
  previewMimeType     String?
  previewSizeBytes    Int?
  previewStorageKey   String?
  thumbnailUrl        String?
  thumbnailMimeType   String?
  thumbnailSizeBytes  Int?
  thumbnailStorageKey String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([contentId, createdAt])
  @@index([clinicId, createdAt])
  @@index([organizationId, kind])
}

model LearningEnrollment {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?                  @relation(fields: [clinicId], references: [id])
  contentId      String
  content        LearningContent          @relation(fields: [contentId], references: [id])
  userId         String
  user           User                     @relation("LearningEnrollmentUser", fields: [userId], references: [id])
  assignedById   String?
  assignedBy     User?                    @relation("LearningEnrollmentAssigner", fields: [assignedById], references: [id])
  status         LearningEnrollmentStatus @default(ASSIGNED)
  assignedAt     DateTime                 @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  score          Decimal?                 @db.Decimal(5, 2)

  @@unique([contentId, userId])
  @@index([clinicId, status])
  @@index([userId, status])
}

model MobileDevice {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?          @relation("UserMobileDevices", fields: [userId], references: [id])
  patientId      String?
  patient        Patient?       @relation("PatientMobileDevices", fields: [patientId], references: [id])
  appType        MobileAppType
  platform       MobilePlatform
  deviceId       String
  pushToken      String?
  enabled        Boolean        @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, deviceId])
  @@index([userId, appType])
  @@index([patientId, appType])
}

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?             @relation(fields: [clinicId], references: [id])
  patientId      String?
  patient        Patient?            @relation("PatientNotifications", fields: [patientId], references: [id])
  userId         String?
  user           User?               @relation("UserNotifications", fields: [userId], references: [id])
  campaignId     String?
  campaign       CrmCampaign?        @relation(fields: [campaignId], references: [id])
  channel        NotificationChannel
  status         NotificationStatus  @default(DRAFT)
  templateKey    String?
  recipient      String
  subject        String?
  body           String
  scheduledAt    DateTime?
  sentAt         DateTime?
  failedReason   String?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status])
  @@index([patientId, createdAt])
  @@index([userId, createdAt])
}

model AiRun {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  clinicId         String?
  clinic           Clinic?      @relation(fields: [clinicId], references: [id])
  actorId          String?
  actor            User?        @relation("AiRunActor", fields: [actorId], references: [id])
  module           String
  action           String
  provider         String
  model            String
  baseUrl          String?
  status           String       @default("PENDING")
  input            Json?
  output           Json?
  rawOutput        String?
  error            String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdAt        DateTime     @default(now())
  completedAt      DateTime?

  @@index([organizationId, module, createdAt])
  @@index([clinicId, createdAt])
  @@index([actorId, createdAt])
  @@index([status, createdAt])
}

model AccountingCategory {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  nameEn         String?
  kind           String
  targetPercent  Decimal?                 @db.Decimal(5, 2)
  warningPercent Decimal?                 @db.Decimal(5, 2)
  sortOrder      Int                      @default(0)
  active         Boolean                  @default(true)
  entries        AccountingEntry[]
  budgetTargets  AccountingBudgetTarget[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, kind, active])
}

model AccountingEntry {
  id                            String             @id @default(cuid())
  organizationId                String
  organization                  Organization       @relation(fields: [organizationId], references: [id])
  clinicId                      String?
  clinic                        Clinic?            @relation(fields: [clinicId], references: [id])
  categoryId                    String
  category                      AccountingCategory @relation(fields: [categoryId], references: [id])
  kind                          String
  amount                        Decimal            @db.Decimal(12, 2)
  occurredAt                    DateTime
  vendor                        String?
  description                   String
  paymentMethod                 String?
  reference                     String?
  attachmentFileName            String?
  attachmentMimeType            String?
  attachmentSizeBytes           Int?
  attachmentStorageProvider     String?
  attachmentStorageKey          String?
  attachmentThumbnailMimeType   String?
  attachmentThumbnailStorageKey String?
  sourceType                    String             @default("manual")
  sourceId                      String?
  locked                        Boolean            @default(false)
  createdById                   String?
  createdBy                     User?              @relation("AccountingEntryCreator", fields: [createdById], references: [id])
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  @@index([organizationId, occurredAt])
  @@index([clinicId, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([sourceType, sourceId])
}

model AccountingBudgetTarget {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?            @relation(fields: [clinicId], references: [id])
