generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  AREA_MANAGER
  CLINIC_MANAGER
  DENTIST
  HYGIENIST
  FRONT_DESK
  BILLING
  PATIENT
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  ARRIVED
  IN_CHAIR
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum TreatmentStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum PostType {
  ANNOUNCEMENT
  CASE_DISCUSSION
  SHIFT_HANDOFF
  TRAINING
  POLICY
}

enum StaffShiftStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum LeadStatus {
  NEW
  CONTACTED
  CONSULT_BOOKED
  VISITED
  CONVERTED
  LOST
  RECALL
}

enum CrmActivityType {
  CALL
  ZALO
  SMS
  EMAIL
  NOTE
  TASK
  VISIT
  FOLLOW_UP
}

enum InventoryMovementType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  CONSUMPTION
  ADJUSTMENT
  WASTE
  RETURN
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
  LOST
}

enum PrescriptionStatus {
  DRAFT
  SIGNED
  DISPENSED
  CANCELLED
}

enum FormTemplateType {
  CONSENT
  INTAKE
  MEDICAL_HISTORY
  POST_OP
  FINANCIAL_POLICY
  CUSTOM
}

enum PatientFormStatus {
  DRAFT
  SENT
  COMPLETED
  EXPIRED
  VOID
}

enum LearningContentType {
  BOOK
  ARTICLE
  VIDEO
  COURSE
  CHECKLIST
  POLICY
}

enum LearningEnrollmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum MobileAppType {
  PATIENT
  STAFF
}

enum MobilePlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationChannel {
  EMAIL
  SMS
  ZALO
  PUSH
  IN_APP
  PHONE
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

enum ServiceCatalogStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum TreatmentServiceStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCompensationPool {
  DOCTOR
  ASSISTANT
}

enum ServiceCompensationRole {
  CONSULTANT
  OPERATOR
  CLINICAL_SUPPORT
  ASSISTANT_PRIMARY
  ASSISTANT_SECONDARY
}

enum CompensationAccrualStatus {
  EARNED
  APPROVED
  PAID
  VOID
}

model Organization {
  id                             String                          @id @default(cuid())
  name                           String
  slug                           String?                         @unique
  primaryDomain                  String?                         @unique
  legalName                      String?
  taxCode                        String?
  locale                         String                          @default("vi-VN")
  isDemo                         Boolean                         @default(false)
  demoExpiresAt                  DateTime?
  chains                         Chain[]
  clinics                        Clinic[]
  users                          User[]
  userRoleAssignments            UserRoleAssignment[]
  passwordResetTokens            PasswordResetToken[]
  patients                       Patient[]
  posts                          CommunityPost[]
  staffProfiles                  StaffProfile[]
  staffShifts                    StaffShift[]
  attendanceLogs                 AttendanceLog[]
  leaveRequests                  LeaveRequest[]
  payrollRuns                    PayrollRun[]
  payrollPolicies                PayrollPolicy[]
  crmLeads                       CrmLead[]
  crmCampaigns                   CrmCampaign[]
  crmActivities                  CrmActivity[]
  communicationThreads           CommunicationThread[]
  inventoryItemGroups            InventoryItemGroup[]
  inventoryTags                  InventoryTag[]
  inventoryItemTags              InventoryItemTag[]
  inventorySuppliers             InventorySupplier[]
  inventoryItems                 InventoryItem[]
  inventoryLots                  InventoryLot[]
  inventoryMovements             InventoryMovement[]
  purchaseOrders                 PurchaseOrder[]
  equipmentAssets                EquipmentAsset[]
  maintenanceTasks               MaintenanceTask[]
  serviceCategories              ServiceCategory[]
  serviceCatalogItems            ServiceCatalogItem[]
  servicePrices                  ServicePrice[]
  serviceSteps                   ServiceStep[]
  serviceMaterials               ServiceMaterial[]
  serviceMedications             ServiceMedication[]
  serviceCompensationRules       ServiceCompensationRule[]
  treatmentServices              TreatmentService[]
  treatmentServiceProgressEvents TreatmentServiceProgressEvent[]
  receipts                       Receipt[]
  invoices                       Invoice[]
  receiptAllocations             ReceiptAllocation[]
  invoiceItems                   InvoiceItem[]
  patientCreditBalances          PatientCreditBalance[]
  paymentPlans                   PaymentPlan[]
  compensationAccruals           CompensationAccrual[]
  compensationAccrualLines       CompensationAccrualLine[]
  medicationCatalog              MedicationCatalogItem[]
  prescriptionTemplates          PrescriptionTemplate[]
  prescriptions                  Prescription[]
  formTemplates                  FormTemplate[]
  patientForms                   PatientForm[]
  patientFiles                   PatientFile[]
  patientJourneyStates           PatientJourneyState[]
  journeyComments                JourneyComment[]
  workItems                      WorkItem[]
  learningContents               LearningContent[]
  learningEnrollments            LearningEnrollment[]
  learningAssets                 LearningAsset[]
  mobileDevices                  MobileDevice[]
  notifications                  Notification[]
  sourceCommissionPolicies       SourceCommissionPolicy[]
  sourceCommissionAccruals       SourceCommissionAccrual[]
  aiRuns                         AiRun[]
  accountingCategories           AccountingCategory[]
  accountingEntries              AccountingEntry[]
  accountingBudgetTargets        AccountingBudgetTarget[]
  documentSequences              DocumentSequence[]
  auditLogs                      AuditLog[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@index([isDemo, demoExpiresAt])
}

model Chain {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String?
  owner          User?        @relation("ChainOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  name           String
  legalName      String?
  brandName      String?
  taxCode        String?
  phone          String?
  email          String?
  website        String?
  specialty      String       @default("DENTAL")
  primaryColor   String?
  logoUrl        String?
  active         Boolean      @default(true)
  clinics        Clinic[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([ownerId])
}

model Clinic {
  id                             String                          @id @default(cuid())
  organizationId                 String
  organization                   Organization                    @relation(fields: [organizationId], references: [id])
  chainId                        String?
  chain                          Chain?                          @relation(fields: [chainId], references: [id])
  name                           String
  city                           String
  address                        String
  phone                          String?
  active                         Boolean                         @default(true)
  chairs                         Chair[]
  users                          UserClinic[]
  roleAssignments                UserRoleAssignment[]
  patients                       Patient[]
  appointments                   Appointment[]
  invoices                       Invoice[]
  posts                          CommunityPost[]
  staffProfiles                  StaffProfile[]
  staffShifts                    StaffShift[]
  attendanceLogs                 AttendanceLog[]
  leaveRequests                  LeaveRequest[]
  payrollRuns                    PayrollRun[]
  payrollPolicies                PayrollPolicy[]
  crmLeads                       CrmLead[]
  crmCampaigns                   CrmCampaign[]
  crmActivities                  CrmActivity[]
  communicationThreads           CommunicationThread[]
  inventoryItems                 InventoryItem[]
  inventoryLots                  InventoryLot[]
  inventoryMovements             InventoryMovement[]
  purchaseOrders                 PurchaseOrder[]
  equipmentAssets                EquipmentAsset[]
  maintenanceTasks               MaintenanceTask[]
  servicePrices                  ServicePrice[]
  treatmentServices              TreatmentService[]
  treatmentServiceProgressEvents TreatmentServiceProgressEvent[]
  receipts                       Receipt[]
  receiptAllocations             ReceiptAllocation[]
  invoiceItems                   InvoiceItem[]
  patientCreditBalances          PatientCreditBalance[]
  paymentPlans                   PaymentPlan[]
  compensationAccruals           CompensationAccrual[]
  compensationAccrualLines       CompensationAccrualLine[]
  prescriptionTemplates          PrescriptionTemplate[]
  prescriptions                  Prescription[]
  formTemplates                  FormTemplate[]
  patientForms                   PatientForm[]
  patientFiles                   PatientFile[]
  patientJourneyStates           PatientJourneyState[]
  journeyComments                JourneyComment[]
  workItems                      WorkItem[]
  learningContents               LearningContent[]
  learningEnrollments            LearningEnrollment[]
  learningAssets                 LearningAsset[]
  notifications                  Notification[]
  sourceCommissionAccruals       SourceCommissionAccrual[]
  aiRuns                         AiRun[]
  accountingEntries              AccountingEntry[]
  accountingBudgetTargets        AccountingBudgetTarget[]
  documentSequences              DocumentSequence[]
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt

  @@unique([organizationId, name])
  @@index([chainId])
}

model User {
  id                                String                          @id @default(cuid())
  organizationId                    String
  organization                      Organization                    @relation(fields: [organizationId], references: [id])
  email                             String                          @unique
  fullName                          String
  passwordHash                      String
  role                              UserRole
  phone                             String?
  active                            Boolean                         @default(true)
  operationalStatus                 String                          @default("READY")
  operationalStatusUpdatedAt        DateTime?
  mustChangePassword                Boolean                         @default(false)
  passwordChangedAt                 DateTime?
  lastLoginAt                       DateTime?
  clinics                           UserClinic[]
  roleAssignments                   UserRoleAssignment[]
  sessions                          Session[]
  passwordResetTokens               PasswordResetToken[]            @relation("UserPasswordResetTokens")
  createdPasswordResetTokens        PasswordResetToken[]            @relation("PasswordResetTokenCreator")
  appointments                      Appointment[]                   @relation("ProviderAppointments")
  notes                             ClinicalNote[]
  posts                             CommunityPost[]
  comments                          PostComment[]
  staffProfile                      StaffProfile?
  createdTreatmentServices          TreatmentService[]              @relation("TreatmentServiceCreator")
  performedTreatmentEvents          TreatmentServiceProgressEvent[] @relation("TreatmentProgressPerformer")
  clinicalSupportTreatmentEvents    TreatmentServiceProgressEvent[] @relation("TreatmentProgressClinicalSupport")
  primaryAssistantTreatmentEvents   TreatmentServiceProgressEvent[] @relation("TreatmentProgressAssistantPrimary")
  secondaryAssistantTreatmentEvents TreatmentServiceProgressEvent[] @relation("TreatmentProgressAssistantSecondary")
  ownedLeads                        CrmLead[]                       @relation("CrmLeadOwner")
  crmActivities                     CrmActivity[]                   @relation("CrmActivityActor")
  communicationMessages             CommunicationMessage[]          @relation("CommunicationMessageSender")
  inventoryMovements                InventoryMovement[]             @relation("InventoryMovementUser")
  prescriptionTemplates             PrescriptionTemplate[]          @relation("PrescriptionTemplateAuthor")
  prescriptions                     Prescription[]                  @relation("PrescriptionPrescriber")
  createdFormTemplates              FormTemplate[]                  @relation("FormTemplateCreator")
  requestedPatientForms             PatientForm[]                   @relation("PatientFormRequester")
  uploadedPatientFiles              PatientFile[]                   @relation("PatientFileUploader")
  createdPaymentPlans               PaymentPlan[]                   @relation("PaymentPlanCreator")
  updatedJourneyStates              PatientJourneyState[]           @relation("PatientJourneyStateUpdater")
  authoredJourneyComments           JourneyComment[]                @relation("JourneyCommentAuthor")
  assignedWorkItems                 WorkItem[]                      @relation("WorkItemAssignee")
  createdWorkItems                  WorkItem[]                      @relation("WorkItemCreator")
  completedWorkItems                WorkItem[]                      @relation("WorkItemCompleter")
  authoredLearningContents          LearningContent[]               @relation("LearningContentAuthor")
  learningEnrollments               LearningEnrollment[]            @relation("LearningEnrollmentUser")
  assignedLearningEnrollments       LearningEnrollment[]            @relation("LearningEnrollmentAssigner")
  uploadedLearningAssets            LearningAsset[]                 @relation("LearningAssetUploader")
  compensationAccrualLines          CompensationAccrualLine[]       @relation("CompensationLineUser")
  mobileDevices                     MobileDevice[]                  @relation("UserMobileDevices")
  notifications                     Notification[]                  @relation("UserNotifications")
  createdAiRuns                     AiRun[]                         @relation("AiRunActor")
  createdAccountingEntries          AccountingEntry[]               @relation("AccountingEntryCreator")
  ownedChains                       Chain[]                         @relation("ChainOwner")
  auditLogs                         AuditLog[]
  createdAt                         DateTime                        @default(now())
  updatedAt                         DateTime                        @updatedAt
}

model UserRoleAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  scopeKey       String       @default("GLOBAL")
  role           UserRole
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, role, scopeKey])
  @@index([organizationId, role, active])
  @@index([clinicId, role, active])
}

model PasswordResetToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation("PasswordResetTokenCreator", fields: [createdById], references: [id])
  tokenHash      String       @unique
  purpose        String       @default("PASSWORD_RESET")
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, expiresAt])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String   @unique
  activeClinicId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([userId, expiresAt])
}

model SecurityRateLimitBucket {
  keyHash   String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model UserClinic {
  userId   String
  clinicId String
  user     User   @relation(fields: [userId], references: [id])
  clinic   Clinic @relation(fields: [clinicId], references: [id])

  @@id([userId, clinicId])
}

model Chair {
  id                         String        @id @default(cuid())
  clinicId                   String
  clinic                     Clinic        @relation(fields: [clinicId], references: [id])
  name                       String
  specialty                  String?
  active                     Boolean       @default(true)
  operationalStatus          String        @default("READY")
  operationalStatusUpdatedAt DateTime?
  appointments               Appointment[]

  @@unique([clinicId, name])
}

model Patient {
  id                       String                    @id @default(cuid())
  organizationId           String
  organization             Organization              @relation(fields: [organizationId], references: [id])
  clinicId                 String
  clinic                   Clinic                    @relation(fields: [clinicId], references: [id])
  fullName                 String
  dateOfBirth              DateTime?
  phone                    String
  email                    String?
  gender                   String?
  visitReason              String?
  leadSource               String                    @default("WALK_IN")
  nationalId               String?
  address                  String?
  guardianName             String?
  medicalAlerts            String[]
  appointments             Appointment[]
  consents                 PatientConsent[]
  notes                    ClinicalNote[]
  treatmentPlans           TreatmentPlan[]
  treatmentServices        TreatmentService[]
  invoices                 Invoice[]
  receipts                 Receipt[]
  receiptAllocations       ReceiptAllocation[]
  invoiceItems             InvoiceItem[]
  creditBalance            PatientCreditBalance?
  paymentPlans             PaymentPlan[]
  crmLeads                 CrmLead[]
  crmActivities            CrmActivity[]
  communicationThreads     CommunicationThread[]
  prescriptions            Prescription[]
  forms                    PatientForm[]
  files                    PatientFile[]
  journeyState             PatientJourneyState?
  journeyComments          JourneyComment[]
  workItems                WorkItem[]
  mobileDevices            MobileDevice[]            @relation("PatientMobileDevices")
  notifications            Notification[]            @relation("PatientNotifications")
  sourceCommissionAccruals SourceCommissionAccrual[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([organizationId, phone])
}

model PatientConsent {
  id        String        @id @default(cuid())
  patientId String
  patient   Patient       @relation(fields: [patientId], references: [id])
  status    ConsentStatus
  purpose   String
  channel   String
  signedAt  DateTime?
  expiresAt DateTime?
  version   String
  createdAt DateTime      @default(now())
}

model Appointment {
  id         String            @id @default(cuid())
  clinicId   String
  clinic     Clinic            @relation(fields: [clinicId], references: [id])
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  providerId String
  provider   User              @relation("ProviderAppointments", fields: [providerId], references: [id])
  chairId    String?
  chair      Chair?            @relation(fields: [chairId], references: [id])
  status     AppointmentStatus @default(REQUESTED)
  startsAt   DateTime
  endsAt     DateTime
  reason     String
  source     String            @default("staff")
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([clinicId, startsAt])
}

model ClinicalNote {
  id         String    @id @default(cuid())
  patientId  String
  patient    Patient   @relation(fields: [patientId], references: [id])
  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  subjective String?
  objective  String?
  assessment String?
  plan       String?
  lockedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model TreatmentPlan {
  id          String             @id @default(cuid())
  patientId   String
  patient     Patient            @relation(fields: [patientId], references: [id])
  title       String
  status      TreatmentStatus    @default(DRAFT)
  totalAmount Decimal            @db.Decimal(12, 2)
  patientDue  Decimal            @db.Decimal(12, 2)
  phases      TreatmentPhase[]
  services    TreatmentService[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TreatmentPhase {
  id              String        @id @default(cuid())
  treatmentPlanId String
  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
  name            String
  sequence        Int
  procedures      String[]
  estimatedAmount Decimal       @db.Decimal(12, 2)
  completedAt     DateTime?
}

model Invoice {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  clinicId           String
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id])
  invoiceNo          String
  status             InvoiceStatus       @default(OPEN)
  amount             Decimal             @db.Decimal(12, 2)
  paidAmount         Decimal             @db.Decimal(12, 2)
  dueDate            DateTime
  payments           Payment[]
  items              InvoiceItem[]
  receiptAllocations ReceiptAllocation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, invoiceNo])
  @@index([organizationId, clinicId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    String
  reference String?
  paidAt    DateTime @default(now())
}

model InvoiceItem {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  clinicId           String
  clinic             Clinic              @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id])
  invoiceId          String
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  treatmentServiceId String?
  treatmentService   TreatmentService?   @relation(fields: [treatmentServiceId], references: [id])
  description        String
  quantity           Decimal             @default(1) @db.Decimal(8, 2)
  unitPrice          Decimal             @db.Decimal(12, 2)
  amount             Decimal             @db.Decimal(12, 2)
  receiptAllocations ReceiptAllocation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([invoiceId])
  @@index([treatmentServiceId])
  @@index([patientId, createdAt])
  @@index([clinicId, createdAt])
}

model Receipt {
  id                       String                    @id @default(cuid())
  organizationId           String
  organization             Organization              @relation(fields: [organizationId], references: [id])
  clinicId                 String
  clinic                   Clinic                    @relation(fields: [clinicId], references: [id])
  patientId                String
  patient                  Patient                   @relation(fields: [patientId], references: [id])
  receiptNo                String
  amount                   Decimal                   @db.Decimal(12, 2)
  allocatedAmount          Decimal                   @default(0) @db.Decimal(12, 2)
  unallocatedAmount        Decimal                   @default(0) @db.Decimal(12, 2)
  method                   String
  reference                String?
  note                     String?
  receivedAt               DateTime                  @default(now())
  allocations              ReceiptAllocation[]
  sourceCommissionAccruals SourceCommissionAccrual[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([organizationId, receiptNo])
  @@index([clinicId, receivedAt])
  @@index([patientId, receivedAt])
}

model ReceiptAllocation {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  clinicId           String
  clinic             Clinic            @relation(fields: [clinicId], references: [id])
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id])
  receiptId          String
  receipt            Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId          String?
  invoice            Invoice?          @relation(fields: [invoiceId], references: [id])
  invoiceItemId      String?
  invoiceItem        InvoiceItem?      @relation(fields: [invoiceItemId], references: [id])
  treatmentServiceId String?
  treatmentService   TreatmentService? @relation(fields: [treatmentServiceId], references: [id])
  amount             Decimal           @db.Decimal(12, 2)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([receiptId])
  @@index([invoiceId])
  @@index([invoiceItemId])
  @@index([treatmentServiceId])
  @@index([patientId, createdAt])
}

model PatientCreditBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id])
  patientId      String       @unique
  patient        Patient      @relation(fields: [patientId], references: [id])
  amount         Decimal      @default(0) @db.Decimal(12, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([clinicId])
}

model PaymentPlan {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  clinicId       String
  clinic         Clinic                   @relation(fields: [clinicId], references: [id])
  patientId      String
  patient        Patient                  @relation(fields: [patientId], references: [id])
  createdById    String?
  createdBy      User?                    @relation("PaymentPlanCreator", fields: [createdById], references: [id])
  planNo         String
  status         String                   @default("ACTIVE")
  totalAmount    Decimal                  @db.Decimal(12, 2)
  note           String?
  installments   PaymentPlanInstallment[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, planNo])
  @@index([clinicId, status])
  @@index([patientId, status])
}

model PaymentPlanInstallment {
  id             String      @id @default(cuid())
  paymentPlanId  String
  paymentPlan    PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  sequence       Int
  amount         Decimal     @db.Decimal(12, 2)
  dueAt          DateTime
  status         String      @default("SCHEDULED")
  paidAt         DateTime?
  notificationId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([paymentPlanId, sequence])
  @@index([dueAt, status])
}

model CommunityPost {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  type           PostType
  title          String
  body           String
  tags           String[]
  comments       PostComment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id])
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
