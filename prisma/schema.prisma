  category       AccountingCategory @relation(fields: [categoryId], references: [id])
  periodMonth    String
  targetPercent  Decimal            @db.Decimal(5, 2)
  warningPercent Decimal?           @db.Decimal(5, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, clinicId, categoryId, periodMonth])
  @@index([organizationId, periodMonth])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  action         String
  entityType     String
  entityId       String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  clinicId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  scopeKey       String       @default("organization")
  type           String
  year           Int
  currentValue   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, scopeKey, type, year])
  @@index([clinicId, type, year])
}
