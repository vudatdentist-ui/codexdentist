{
  "name": "codexdentist",
  "version": "1.0.0-beta.0",
  "license": "AGPL-3.0-or-later",
  "description": "Open-source dental clinic operating system for Viet Nam",
  "private": true,
  "homepage": "https://codexdentist.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vudatdentist-ui/codexdentist.git"
  },
  "bugs": {
    "url": "https://github.com/vudatdentist-ui/codexdentist/issues"
  },
  "scripts": {
    "dev": "npm run fonts:assets && codexdentist-odontogram-assets public/odontogram-assets && next dev --webpack",
    "prebuild": "npm run typecheck",
    "build": "npm run fonts:assets && codexdentist-odontogram-assets public/odontogram-assets && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:cpanel": "node server.cjs",
    "codexdentist": "node scripts/codexdentist.mjs",
    "start:selfhost:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-self-host-start.ps1",
    "stop:selfhost:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-self-host-stop.ps1",
    "test:integration": "node scripts/integration-actions.mjs",
    "test:integration-substrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/integration-substrate-smoke.mjs",
    "test:file-lifecycle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/patient-file-lifecycle-smoke.mjs",
    "test:journey-file-command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/journey-file-command-smoke.mjs",
    "test:phase2": "npm run test:integration-substrate && npm run test:journey-file-command && npm run test:file-lifecycle",
    "test:phase3:payos": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase3-payos-client-smoke.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase3-payos-webhook-smoke.mjs",
    "test:phase3:documenso": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase3-documenso-smoke.mjs",
    "test:phase3": "npm run test:phase3:payos && npm run test:phase3:documenso && node scripts/provider-settlement-concurrency.cjs",
    "test:payos": "node --test scripts/payos-workflows.test.cjs scripts/payos-retry-regression.test.cjs scripts/integration-vault.test.cjs",
    "test:integration-vault-db": "node scripts/integration-vault-postgres.cjs",
    "browser:payos": "node scripts/run-payos-workspace-qa.mjs",
    "browser:payos-production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/payos-workspace-qa.mjs --production-ui",
    "test:billing": "node scripts/billing-edge-smoke.mjs",
    "test:billing-concurrency": "node scripts/billing-concurrency-smoke.mjs",
    "test:source-commission": "node scripts/source-commission-smoke.mjs",
    "test:compensation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/compensation-smoke.mjs",
    "test:m789": "node scripts/milestone-789-smoke.mjs",
    "test:m1015": "node scripts/milestone-1015-smoke.mjs",
    "test:actions": "node scripts/action-permission-smoke.mjs",
    "test:settings-forms": "node scripts/settings-form-action-smoke.mjs",
    "test:patient-files": "node scripts/patient-file-protected-smoke.mjs",
    "test:hardening": "node scripts/hardening-smoke.mjs",
    "test:security": "node scripts/security-hardening-check.mjs",
    "test:security-runtime": "node scripts/security-regression-smoke.mjs",
    "test:tenant": "node scripts/tenant-isolation-smoke.mjs",
    "test:pilot-workflows": "node scripts/pilot-workflow-smoke.mjs",
    "test:data-integrity": "node scripts/data-integrity-smoke.mjs",
    "go-live:check": "node scripts/go-live-check.mjs",
    "test:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/smoke-routes.mjs",
    "test:roles": "node scripts/role-smoke.mjs",
    "test:seed-users": "node scripts/seed-smoke-users.mjs",
    "monitor:health": "node scripts/monitor-health.mjs",
    "readiness:check": "node scripts/readiness-check.mjs",
    "browser:qa": "npm run test:workspace && node scripts/workspace-browser-suite.mjs",
    "browser:trial-signup": "node scripts/trial-signup-browser-smoke.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "agent:health": "node scripts/check-encoding.mjs && node scripts/agent-health-check.mjs",
    "agent:audit": "node scripts/agent-module-audit.mjs",
    "backup:postgres": "powershell -ExecutionPolicy Bypass -File scripts/pg-backup.ps1",
    "restore:postgres": "powershell -ExecutionPolicy Bypass -File scripts/pg-restore.ps1",
    "r2:test": "node scripts/test-r2.mjs",
    "mobile:android:add": "cap add android",
    "mobile:android:sync": "cap sync android",
    "mobile:android:open": "cap open android",
    "billing:repair-ledger": "node scripts/repair-billing-ledger.mjs",
    "data:reset-operational": "node scripts/reset-operational-data.mjs",
    "pilot:prepare": "node scripts/prepare-pilot.mjs",
    "pilot:qa": "node scripts/pilot-qa.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:schedule": "node scripts/seed-schedule-demo.mjs",
    "odontogram:assets": "codexdentist-odontogram-assets public/odontogram-assets",
    "browser:landing": "node scripts/landing-page-qa.mjs",
    "test:workspace": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-loader ./scripts/ts-alias-loader.mjs --test scripts/workspace-story.test.mjs scripts/workspace-controls.test.mjs scripts/patient-workspace.test.mjs scripts/patient-keyboard.test.mjs",
    "fonts:assets": "node scripts/fetch-font-assets.mjs",
    "test:audit": "node --test scripts/audit-regression.test.cjs scripts/shared-login.test.cjs scripts/integration-boundaries.test.cjs scripts/provider-webhook-regression.test.cjs scripts/provider-consent-regression.test.cjs scripts/notification-provider.test.cjs scripts/notification-readiness.test.mjs scripts/financial-ledger-regression.test.cjs scripts/billing-boundary.test.cjs",
    "test:audit-db": "node scripts/audit-concurrency.cjs",
    "test:maintainability": "node --test scripts/maintainability-regression.test.cjs && node scripts/maintainability-check.mjs",
    "test:maintainability-db": "node scripts/maintainability-database.cjs",
    "test:demo-cleanup-db": "node scripts/demo-cleanup-database.cjs",
    "test:seed-ledger-db": "node scripts/seed-ledger-database.cjs",
    "test:financial-ledger-db": "node scripts/run-financial-ledger-regression.cjs",
    "test:migration-role-db": "node scripts/migration-role-regression.cjs",
    "test:organization-purge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/organization-purge-smoke.mjs",
    "test:phase4": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase4-orthanc-smoke.mjs",
    "test:phase4:scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase4-imaging-scope-smoke.mjs",
    "test:phase5": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase5-lab-smoke.mjs",
    "test:phase5:sterilization": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase5-sterilization-smoke.mjs",
    "test:phase6": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/phase6-fhir-smoke.mjs",
    "test:api-contract": "node scripts/api-contract-smoke.mjs",
    "test:disposable-restore": "node scripts/disposable-postgres-restore-smoke.mjs",
    "test:domain-operations": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs scripts/domain-operations-smoke.mjs && node scripts/phase5-operator-contract-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1040.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "codexdentist-odontogram": "https://github.com/vudatdentist-ui/codexdentist-odontogram/releases/download/v0.8.2/codexdentist-odontogram-0.8.2.tgz",
    "lucide-react": "1.11.0",
    "next": "16.4.2",
    "pg": "8.20.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@types/node": "25.9.9",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.64.1",
    "prisma": "7.10.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "fast-uri": "4.2.3",
    "fast-xml-builder": "1.3.0",
    "hono": "4.13.13",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "valibot": "1.4.2",
    "nanoid": "3.3.19",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2",
    "@xmldom/xmldom": "0.9.12",
    "brace-expansion": "5.0.12",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
