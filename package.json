{
  "name": "codexdentist",
  "version": "1.0.0-beta.0",
  "license": "AGPL-3.0-or-later",
  "description": "Open-source dental clinic operating system for Viet Nam",
  "private": true,
  "homepage": "https://codexdentist.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vudatdentist-ui/codexdentist.git"
  },
  "bugs": {
    "url": "https://github.com/vudatdentist-ui/codexdentist/issues"
  },
  "scripts": {
    "dev": "codexdentist-odontogram-assets public/odontogram-assets && next dev --webpack",
    "prebuild": "npm run typecheck",
    "build": "codexdentist-odontogram-assets public/odontogram-assets && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:cpanel": "node server.cjs",
    "codexdentist": "node scripts/codexdentist.mjs",
    "start:selfhost:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-self-host-start.ps1",
    "stop:selfhost:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-self-host-stop.ps1",
    "test:integration": "node scripts/integration-actions.mjs",
    "test:billing": "node scripts/billing-edge-smoke.mjs",
    "test:billing-concurrency": "node scripts/billing-concurrency-smoke.mjs",
    "test:source-commission": "node scripts/source-commission-smoke.mjs",
    "test:m789": "node scripts/milestone-789-smoke.mjs",
    "test:m1015": "node scripts/milestone-1015-smoke.mjs",
    "test:actions": "node scripts/action-permission-smoke.mjs",
    "test:settings-forms": "node scripts/settings-form-action-smoke.mjs",
    "test:patient-files": "node scripts/patient-file-protected-smoke.mjs",
    "test:hardening": "node scripts/hardening-smoke.mjs",
    "test:security": "node scripts/security-hardening-check.mjs",
    "test:security-runtime": "node scripts/security-regression-smoke.mjs",
    "test:tenant": "node scripts/tenant-isolation-smoke.mjs",
    "test:pilot-workflows": "node scripts/pilot-workflow-smoke.mjs",
    "test:data-integrity": "node scripts/data-integrity-smoke.mjs",
    "go-live:check": "node scripts/go-live-check.mjs",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:roles": "node scripts/role-smoke.mjs",
    "test:seed-users": "node scripts/seed-smoke-users.mjs",
    "monitor:health": "node scripts/monitor-health.mjs",
    "readiness:check": "node scripts/readiness-check.mjs",
    "browser:qa": "node scripts/browser-qa-audit.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "agent:health": "node scripts/check-encoding.mjs && node scripts/agent-health-check.mjs",
    "agent:audit": "node scripts/agent-module-audit.mjs",
    "backup:postgres": "powershell -ExecutionPolicy Bypass -File scripts/pg-backup.ps1",
    "restore:postgres": "powershell -ExecutionPolicy Bypass -File scripts/pg-restore.ps1",
    "r2:test": "node scripts/test-r2.mjs",
    "mobile:android:add": "cap add android",
    "mobile:android:sync": "cap sync android",
    "mobile:android:open": "cap open android",
    "billing:repair-ledger": "node scripts/repair-billing-ledger.mjs",
    "data:reset-operational": "node scripts/reset-operational-data.mjs",
    "pilot:prepare": "node scripts/prepare-pilot.mjs",
    "pilot:qa": "node scripts/pilot-qa.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:schedule": "node scripts/seed-schedule-demo.mjs",
    "odontogram:assets": "codexdentist-odontogram-assets public/odontogram-assets"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1040.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "codexdentist-odontogram": "https://github.com/vudatdentist-ui/codexdentist-odontogram/releases/download/v0.8.2/codexdentist-odontogram-0.8.2.tgz",
    "lucide-react": "1.11.0",
    "next": "16.2.11",
    "pg": "8.20.0",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/cli": "8.3.1",
    "@capacitor/core": "8.3.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "1.60.0",
    "prisma": "7.8.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "4.1.1",
    "fast-xml-builder": "1.3.0",
    "hono": "4.12.31",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "valibot": "1.4.2"
  }
}
