POSTGRES_PASSWORD="generate-a-random-password"
AUTH_SECRET="generate-a-different-random-secret"
JOB_SECRET="generate-another-random-secret"
CODEXDENTIST_PORT="3000"
APP_BASE_URL="http://127.0.0.1:3000"
APP_ROOT_DOMAIN="codexdentist.local"
SESSION_COOKIE_SECURE="false"
TRUSTED_PROXY_PROVIDER="none"
NOTIFICATION_DELIVERY_MODE="disabled"
CODEXMED_AI_ENABLED="false"
CODEXDENTIST_IMAGE="codexdentist:local"

# Optional external integrations. The self-host bundle runs PostgreSQL and the app only;
# configure Orthanc/OHIF separately on a private network before enabling imaging.
# Use secretRef="env:PAYOS_DEFAULT" or
# secretRef="env:DOCUMENSO_DEFAULT" when configuring IntegrationConnection.
PAYOS_DEFAULT_CLIENT_ID=""
PAYOS_DEFAULT_API_KEY=""
PAYOS_DEFAULT_CHECKSUM_KEY=""
PAYOS_DEFAULT_BASE_URL="https://api-merchant.payos.vn"
DOCUMENSO_DEFAULT_API_TOKEN=""
DOCUMENSO_DEFAULT_WEBHOOK_SECRET=""
DOCUMENSO_DEFAULT_BASE_URL="https://app.documenso.com/api/v2"
ORTHANC_DEFAULT_BASE_URL="http://orthanc:8042"
ORTHANC_DEFAULT_USERNAME=""
ORTHANC_DEFAULT_PASSWORD=""
ORTHANC_DEFAULT_VIEWER_BASE_URL="http://ohif:80/viewer"
ORTHANC_DEFAULT_VIEWER_ACCESS_MODE="disabled"
FHIR_EXPORT_ENABLED="false"
